# Enquiry backend (npm run api). Copy to .env and fill what you need.

# Where the API listens. Keep 127.0.0.1 locally; set HOST=0.0.0.0 on a server.
PORT=8787
HOST=127.0.0.1

# SQLite file. Relative paths resolve from the project root.
ENQUIRY_DB=server/data/enquiries.db

# Bearer token for the studio inbox (GET /api/enquiries).
# Leave empty to disable reading enquiries over HTTP; use a long random string.
ENQUIRY_ADMIN_TOKEN=

# Optional notification. Any endpoint that accepts a JSON POST works
# (Slack incoming webhook, Zapier/Make catch hook, n8n, your own mail relay).
# Without it, every enquiry is still saved to the database above.
ENQUIRY_WEBHOOK_URL=
